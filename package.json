    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^58.0.24",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "export:web": "expo export --platform web",
    "privacy": "node scripts/build-privacy.mjs",
    "build:apk": "npx eas-cli@latest build -p android --profile preview",
    "build:android": "npx eas-cli@latest build -p android --profile production",
    "build:ios": "npx eas-cli@latest build -p ios --profile production",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "update:production": "npx eas-cli@latest update --channel production --environment production"
  },
  "private": true
}
