{
  "expo": {
    "name": "Liftmark",
    "slug": "liftmark",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "site.mhel.liftmark",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "site.mhel.liftmark",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_EXERCISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0E0F12"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#C6F432"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Liftmark reads your steps, sleep and body weight to set your calorie target, show your recovery and log weigh-ins from your scale.",
          "NSHealthUpdateUsageDescription": "Liftmark saves your finished workouts to Apple Health so they count toward your activity.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "scheme": "liftmark",
    "experiments": {
      "typedRoutes": true
    },
    "description": "Free, offline-first workout tracker that tells you whether you are getting stronger and what to do next session.",
    "githubUrl": "https://github.com/borkangole/Repster---Your-progress-partner",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/2e701b52-2a9f-4c6e-a890-0db96981247f"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2e701b52-2a9f-4c6e-a890-0db96981247f"
      }
    },
    "owner": "fazermb"
  }
}
